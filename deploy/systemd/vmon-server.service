[Unit]
Description=vmon 维测服务中心
Documentation=file:/opt/vmon/docs/deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vmon
Group=vmon
WorkingDirectory=/opt/vmon
ExecStart=/opt/vmon/bin/vmon-server --config /etc/vmon/server.json
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# 资源限额：中心服务不得挤占业务节点资源。
MemoryMax=2G
CPUQuota=200%
TasksMax=512

# 最小权限：只允许写状态目录，其余文件系统只读。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
StateDirectory=vmon-server
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
